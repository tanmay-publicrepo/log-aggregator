{
  "connector.class": "io.aiven.kafka.connect.opensearch.OpensearchSinkConnector",
  "tasks.max": "2",
  "topics": "logs.raw",
  "connection.url": "http://opensearch:9200",
  "key.ignore": "true",
  "schema.ignore": "true",
  "batch.size": "500",
  "linger.ms": "100",
  "max.retries": "10",
  "retry.backoff.ms": "500",
  "behavior.on.malformed.documents": "report",
  "behavior.on.null.values": "ignore",

  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://schema-registry:8081",

  "transforms": "ts,meta",
  "transforms.ts.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.ts.field": "timestamp",
  "transforms.ts.target.type": "string",
  "transforms.ts.format": "yyyy-MM-dd'T'HH:mm:ss.SSSX",
  "transforms.meta.type": "org.apache.kafka.connect.transforms.InsertField$Value",
  "transforms.meta.partition.field": "kafka_partition",
  "transforms.meta.offset.field": "kafka_offset",

  "errors.tolerance": "all",
  "errors.log.enable": "true",
  "errors.log.include.messages": "true",
  "errors.deadletterqueue.topic.name": "logs.connect-dlq",
  "errors.deadletterqueue.topic.replication.factor": "1",
  "errors.deadletterqueue.context.headers.enable": "true"
}