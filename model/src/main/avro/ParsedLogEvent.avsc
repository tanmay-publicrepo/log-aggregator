{
  "type": "record",
  "name": "ParsedLogEvent",
  "namespace": "dev.tanmay.logagg.model",
  "doc": "One log line parsed into typed fields by the processor",
  "fields": [
    { "name": "service", "type": "string", "doc": "from the line when present, else the shipper's value" },
    { "name": "host", "type": "string" },
    { "name": "event_time", "type": { "type": "long", "logicalType": "timestamp-millis" }, "doc": "timestamp written in the line" },
    { "name": "ingest_time", "type": { "type": "long", "logicalType": "timestamp-millis" }, "doc": "when the shipper read the line" },
    { "name": "level", "type": "string" },
    { "name": "message", "type": "string" },
    { "name": "trace_id", "type": ["null", "string"], "default": null },
    { "name": "status_code", "type": ["null", "int"], "default": null },
    { "name": "latency_ms", "type": ["null", "long"], "default": null },
    { "name": "format", "type": "string", "doc": "JSON or TEXT" },
    { "name": "raw", "type": "string" }
  ]
}